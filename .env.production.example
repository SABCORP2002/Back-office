# Public address used to access this backoffice. Caddy generates HTTPS
# certificates automatically when this domain points to the server IP.
APP_DOMAIN=backoffice.example.com
APP_ORIGIN=https://backoffice.example.com

# PostgreSQL stays private inside Docker. Use only letters and digits in this
# password so its generated connection URL remains valid.
POSTGRES_DB=jal_trade
POSTGRES_USER=jal_trade
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-password

# Generate every secret separately, for example: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-with-a-second-long-random-secret
JWT_REFRESH_TTL=30d
PIN_PEPPER=replace-with-a-third-long-random-secret

# First account allowed to connect to the backoffice.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-long-admin-password

# Backend settings
WEBHOOK_SECRET_MOMO=replace-with-a-random-webhook-secret
WEBHOOK_SECRET_PROVIDER=replace-with-a-random-webhook-secret
WEBHOOK_SECRET_BLOCKCHAIN=replace-with-a-random-webhook-secret
QUOTE_VALIDITY_SECONDS=60
MOMO_PAYMENT_MAX_MINUTES=10
INTERVENTION_MULTIPLIER=2
RATE_TOLERANCE_PCT=0.5
RECONCILIATION_ANOMALY_CYCLES=2
PROVIDER_DEGRADED_FAILURE_RATE_PCT=20
PROVIDER_DOWN_FAILURE_RATE_PCT=50
CONFIRMATIONS_TRC20=20
CONFIRMATIONS_ERC20=15
CONFIRMATIONS_BEP20=15
REFUND_DUAL_VALIDATION_THRESHOLD=100000
