# Copy to .env and fill in. See ARCHITECTURE.md "Configuration" for what each
# CONFIGURABLE value means and which spec section governs it.

# --- Database (TDS §1 — ACID relational store, single cluster of authority) ---
DATABASE_URL="postgresql://jal:jal@localhost:5432/jal_trade?schema=public"

# --- Auth (Arch §12) ---
JWT_ACCESS_SECRET="change-me-dev-only"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="change-me-dev-only-too"
JWT_REFRESH_TTL="30d"
PIN_PEPPER="change-me-dev-only"

# --- Webhooks (TDS §8) — one shared secret per source in production; fake/shared here ---
WEBHOOK_SECRET_MOMO="dev-momo-webhook-secret"
WEBHOOK_SECRET_PROVIDER="dev-provider-webhook-secret"
WEBHOOK_SECRET_BLOCKCHAIN="dev-blockchain-webhook-secret"

# --- Admin bootstrap (dev only — real onboarding is out of scope this pass) ---
ADMIN_BOOTSTRAP_EMAIL="admin@jal.trade"
ADMIN_BOOTSTRAP_PASSWORD="change-me-dev-only"

# --- Parameters V1 chiffrés (TDS §19) — Proposition V1 defaults, all overridable ---
QUOTE_VALIDITY_SECONDS=60
MOMO_PAYMENT_MAX_MINUTES=10
INTERVENTION_MULTIPLIER=2
RATE_TOLERANCE_PCT=0.5
RECONCILIATION_ANOMALY_CYCLES=2
PROVIDER_DEGRADED_FAILURE_RATE_PCT=20
PROVIDER_DOWN_FAILURE_RATE_PCT=50

# Confirmations required per network (TDS §12 — CONFIGURABLE, sandbox values)
CONFIRMATIONS_TRC20=20
CONFIRMATIONS_ERC20=15
CONFIRMATIONS_BEP20=15

# TDS §19 — "Seuil de double validation — remboursement, à définir par la
# Finance" — CONFIGURABLE, this is a placeholder for local dev only.
REFUND_DUAL_VALIDATION_THRESHOLD=100000

PORT=3000

# Comma-separated browser origins allowed to call the API.
# In production, set this to the exact Vercel backoffice URL.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# --- Real provider credentials (TDS §14: never committed with real values —
# fill these in ONLY in your local, gitignored .env, never here) ---
# Yellow Card — crypto liquidity provider (ProviderAdapter)
YELLOWCARD_PUBLIC_KEY=
YELLOWCARD_SECRET_KEY=
# Tranzak — Mobile Money aggregator, Cameroon (MomoAdapter)
TRANZAK_APP_ID=
TRANZAK_APP_KEY=
# Paydunya — Mobile Money aggregator, West Africa (MomoAdapter)
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
# Elyonpay — role unconfirmed, treated as MomoAdapter pending confirmation
ELYONPAY_USERNAME=
ELYONPAY_PASSWORD=
